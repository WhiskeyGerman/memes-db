# Generate unique local credentials:
# poetry run python deploy/scripts/generate_env.py --release-id <immutable-release-id>
# Keep deploy/.env out of version control.
MEMES_RELEASE_ID=
POSTGRES_PASSWORD=
IDENTITY_DATABASE_PASSWORD=
CATALOG_DATABASE_PASSWORD=
PROCESSING_DATABASE_PASSWORD=
SEARCH_DATABASE_PASSWORD=
MEMES_IDENTITY_DATABASE_URL=postgresql+asyncpg://memes_identity:REPLACE@postgres:5432/memes_identity
MEMES_CATALOG_DATABASE_URL=postgresql+asyncpg://memes_catalog:REPLACE@postgres:5432/memes_catalog
MEMES_PROCESSING_DATABASE_URL=postgresql+asyncpg://memes_processing:REPLACE@postgres:5432/memes_processing
MEMES_SEARCH_DATABASE_URL=postgresql+asyncpg://memes_search:REPLACE@postgres:5432/memes_search
MEMES_INTERNAL_API_KEY=
MEMES_S3_ACCESS_KEY=
MEMES_S3_SECRET_KEY=
MEMES_S3_BUCKET=memes-media
MEMES_JOURNAL_BUCKET=memes-deletion-journal
MEMES_S3_PORT=58334
MEMES_POSTGRES_PORT=55433
MEMES_S3_PUBLIC_ENDPOINT_URL=http://host.docker.internal:58334
MEMES_CSRF_ALLOWED_ORIGINS='["http://localhost:8080","http://localhost:8081","http://localhost:8083"]'
MEMES_COOKIE_SECURE=false
MEMES_ALLOW_INSECURE_HTTP=true
MEMES_WORKER_DEVICE=cpu
MEMES_WORKER_OPERATIONS=preview
MEMES_WORKER_MODELS_DIRECTORY=./models
